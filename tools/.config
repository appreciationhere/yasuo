
#
# APPS
#
CONFIG_CMD_SDRAM_TEST=y
# end of APPS

#
# COMPONENT
#

#
# DRIVERS
#
CONFIG_SDRAM_W9825G6KH=y
CONFIG_UART_TTY=y
# end of DRIVERS

#
# SERVICE
#

#
# FRAMEWORKS BOARD
#
CONFIG_STM32H750=y
# CONFIG_STM32F4XX is not set
CONFIG_STM32_HAL=y
CONFIG_STM32H750_ART_PI=y
# end of FRAMEWORKS BOARD

#
# FRAMEWORKS SYSTEM
#
CONFIG_SYSLOG_PRINT_EN=y
CONFIG_SYSLOG_PRINT_BUFFER_SIZE=256
CONFIG_SYSLOG_PRINT_USART=y
CONFIG_ASYNC_WORK_NOTES_MAX=6
# end of FRAMEWORKS SYSTEM
